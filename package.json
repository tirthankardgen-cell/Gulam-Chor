{
  "name": "gulam-chor",
  "version": "0.1.0",
  "private": true,
  "description": "Play Gulam Chor online with 2–6 friends in private, live rooms.",
  "scripts": {
    "predev": "npm run art:sync",
    "dev": "next dev --webpack",
    "prebuild": "npm run art:sync",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/game.test.ts src/lib/room.test.ts",
    "test:integration": "node scripts/test-multiplayer.mjs",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-gulam-chor --only auth,database,functions",
    "art:sync": "node scripts/sync-art.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@fontsource/hind": "^5.2.7",
    "@fontsource/yatra-one": "^5.2.7",
    "firebase": "^12.19.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "firebase-tools": "^15.35.0",
    "tailwindcss": "4.3.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
